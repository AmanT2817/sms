# Database URL — SQLite file for local development (zero-config, no DB server).
DATABASE_URL="file:/home/z/my-project/db/school.db"

# 32+ character random string used to sign/encrypt session cookies.
# Generate your own with: openssl rand -base64 32
SESSION_SECRET="change-me-this-must-be-a-long-random-string-32+chars"

# Session lifetime in seconds (default 24h = 86400).
SESSION_TTL_SECONDS="86400"

# Next.js runs on port 3000 by default.
PORT=3000
