// School portal — Phase 1 (identity + auth) + Phase 2 (academic core)
// The uploaded architecture document recommends a modular monolith with one
// shared user table. We model that core here. Later phases (dormitory,
// cafeteria, finance) add linked tables that reference the same User/Student.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // For local dev we use SQLite (zero-config). For Vercel/Postgres deployments,
  // change this line to:  provider = "postgresql"
  // The model definitions below are identical for both providers.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity (Phase 1)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("STAFF") // ADMIN | TEACHER | STAFF | STUDENT | PARENT
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1-1 profile links — populated only for the matching role
  student        Student?
  teacher        Teacher?

  // Audit: who recorded this attendance / grade
  recordedAttendance Attendance[]
  recordedGrades     Grade[]
}

// ─────────────────────────────────────────────────────────────────────────────
// People (Phase 2)
// ─────────────────────────────────────────────────────────────────────────────

model Student {
  id              String   @id @default(cuid())
  admissionNumber String   @unique
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradeLevel      String   // e.g. "Grade 10"
  guardianName    String?
  guardianPhone   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments Enrollment[]
  attendance  Attendance[]
  grades      Grade[]
}

model Teacher {
  id         String   @id @default(cuid())
  employeeId String   @unique
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String?  // e.g. "Mathematics"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  classes Class[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Academics (Phase 2)
// ─────────────────────────────────────────────────────────────────────────────

model Subject {
  id      String   @id @default(cuid())
  name    String   @unique // e.g. "Mathematics"
  code    String   @unique // e.g. "MATH"
  classes Class[]
}

model Class {
  id           String   @id @default(cuid())
  name         String   @unique // e.g. "10A Mathematics"
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  teacherId    String?
  teacher      Teacher? @relation(fields: [teacherId], references: [id])
  academicYear String   // e.g. "2025/2026"
  term         String   // e.g. "Term 1"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments Enrollment[]
  attendance  Attendance[]
  assignments Assignment[]
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, classId])
}

model Attendance {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date         DateTime // the school day (time component ignored)
  status       String   // PRESENT | ABSENT | LATE | EXCUSED
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([studentId, classId, date])
}

model Assignment {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  maxScore    Float
  createdAt   DateTime @default(now())

  grades Grade[]

  @@unique([classId, title])
}

model Grade {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  score        Float
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([studentId, assignmentId])
}
